<Window x:Class="PROG_PART_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PROG_PART_2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="LightCyan">

        <!-- 
            HOME GRID
            This grid serves as the main landing page  of the application.
            It contains a logo for AI , a welcome message to greet users,
            and a navigation button to proceed to the next section.
            Currently hidden by default.
        -->
        <Grid x:Name="home_grid" Visibility="Visible">

            <!-- Logo -->
            <Image 
                Source="/logo.png" 
                Height="200"
                Width="350"
                Margin="225,0,225,217" VerticalAlignment="Bottom"
                   />
            <!-- welcome message-->
            <TextBlock
                Text="Welcome to AI chatbot, click proceed button"
                Height="20"
                Width="270"
                TextAlignment="Center"
                Margin="0,30,0,0"
                FontFamily="Arial Rounded MT Bold"
                />

            <!-- button to continue-->
            <Button Background="Gray"
                Height="40"
                Width="300"
                Margin="0,200,0,0"
                Content="Proceed"
                Click="proceed"
                />

        </Grid>

        <!-- 
            USERNAME GRID
            This grid is for prompting the user for username.
            It contains a logo for AI, a textbox for users to enter their name,
            and a submit button to save the username.
            Hidden .
        -->
        <Grid x:Name="username_grid" Visibility="Hidden">


            <!-- Logo -->
            <Image
                Source="/logo.png" 
                Height="200"
                Width="300"
                Margin="0,0,0,200"
                   />
            <!-- Hint message-->
            <TextBlock Background="Gray"
                Text="Enter username"
                Height="20"
                Width="270"
                TextAlignment="Justify"
                Margin="0,30,0,0"
                FontFamily="Arial Rounded MT Bold"
                />

            <!-- Enter/Prompt username-->
            <TextBox
                Height="40"
                Width="270"
                TextAlignment="Center"
                Margin="0,100,0,0"
                FontFamily="Arial Rounded MT Bold"
                x:Name="usernames_input"
                />

            <!-- error message-->
            <TextBlock
         Text="please enter username to continue..."
         Height="20"
         Width="270"
         TextAlignment="Justify"
         Margin="0,180,0,0"
         Foreground="Red"
         FontFamily="Arial Rounded MT Bold"
         />

            <!-- button to submit name-->
            <Button Background="Gray"
        Height="40"
        Width="270"
        Margin="0,250,0,0"
        Content="capture username"
        Click="submit_name"
        />

        </Grid>

        <!-- 
            CHAT GRID
            This grid handles all messaging and conversation-related features of the application.
            It contains a ListView to display chat messages, a textbox for typing questions,
            and a submit button to send the question to the chat.
            Starting in a hidden state.
        -->
        <Grid x:Name="chat_grid" Visibility="Hidden">


            <!-- List view to show messages show messages-->
            <ListView  Background="LightBlue"
                x:Name="chats" 
                Height="300"
                Margin="0,0,0,120"
                />


            <!-- TextBox to prompt questions-->
            <TextBox Background="Beige"
         x:Name="question"
         Height="50"
         Width="350"
         Margin="10,320,430,0"
         FontSize="14"
         VerticalContentAlignment="Center"
         />

            <!-- SEND BUTTON -->
            <Button Background="#4F46E5"
    Foreground="White"
    Height="50"
    Width="140"
    Margin="300,320,0,0"
    Content="Send Message"
    Click="send"
    FontWeight="SemiBold"
    FontSize="14"
    BorderThickness="0"
    Cursor="Hand"
    />

            <!-- CLEAR BUTTON -->
            <Button Background="#6B7280"
    Foreground="White"
    Height="50"
    Width="140"
    Margin="470,320,0,0"
    Content="Clear Chat"
    Click="ClearChat_Click"
    FontWeight="SemiBold"
    FontSize="14"
    BorderThickness="0"
    Cursor="Hand"
    />

            <!-- EXIT BUTTON -->
            <Button Background="#DC2626"
    Foreground="White"
    Height="50"
    Width="140"
    Margin="640,320,0,0"
    Content="Exit Chat"
    Click="ExitChat_Click"
    FontWeight="SemiBold"
    FontSize="14"
    BorderThickness="0"
    Cursor="Hand"
    />


        </Grid>

    </Grid>
</Window>
